# Copy to .env.local and fill in what you have. Never commit .env.local.
# Everything here is optional — the shop builds and runs with none of it set.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, no trailing slash. Used for metadata, the sitemap, structured
# data and the Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.milltownarchive.co.uk

# ---------------------------------------------------------------------------
# WhatsApp click-to-chat
# ---------------------------------------------------------------------------
# Full international number, digits only, no "+" and no spaces.
# 07897 740194 is written 447897740194.
# Leave blank and every WhatsApp button disappears site-wide.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Where else you sell — shown in the footer when set
# ---------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_VINTED_URL=
NEXT_PUBLIC_DEPOP_URL=
NEXT_PUBLIC_EBAY_URL=

# ---------------------------------------------------------------------------
# Stripe — card payments
# ---------------------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys
# Until STRIPE_SECRET_KEY is set the shop runs in enquiry mode: the bag works,
# and checkout sends the bag by WhatsApp or email instead of taking a card.
STRIPE_SECRET_KEY=

# Flat UK postage in pounds, added as a shipping option at checkout.
# Leave blank and checkout still collects the delivery address, with postage
# confirmed before dispatch. No figure is invented if this is unset.
UK_SHIPPING_GBP=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Any endpoint that accepts a JSON POST — Zapier, Make, Formspree, an Apps
# Script, your own relay. Leave blank and the form tells people to email
# instead of pretending to send.
CONTACT_FORWARD_WEBHOOK=
