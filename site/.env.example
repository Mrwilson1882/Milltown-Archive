# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, no trailing slash. Used for metadata, sitemap and Stripe
# redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.archivewholesale.co.uk

# ---------------------------------------------------------------------------
# WhatsApp click-to-chat
# ---------------------------------------------------------------------------
# Full international number, digits only, no "+", no spaces.
# UK example: 447700900123 (i.e. 07700 900123 written as 44 + number).
# Leave blank and the WhatsApp buttons stay hidden site-wide.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Stripe — payments
# ---------------------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys
# Until STRIPE_SECRET_KEY is set, checkout stays in "enquiry" mode: the cart
# still works and customers are routed to WhatsApp/email instead of card entry.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Optional. Any endpoint that accepts a JSON POST (Zapier, Make, Formspree, a
# Google Apps Script, your own inbox relay). Leave blank and the contact form
# falls back to showing the email address and WhatsApp button instead.
CONTACT_FORWARD_WEBHOOK=

# ---------------------------------------------------------------------------
# WhatsApp Business connector  →  /inbox
# ---------------------------------------------------------------------------
# Drafts replies to incoming WhatsApp Business messages and holds them in a
# review inbox. NOTHING is sent to a customer until you press Send.
# Full walkthrough: docs/whatsapp-connector.md
#
# Leave these blank and the site is completely unaffected — /inbox simply says
# it is not switched on.

# --- Meta: receiving -------------------------------------------------------
# App Secret from Meta → your app → App settings → Basic. Every webhook is
# signature-checked against this; without it nothing is accepted.
WHATSAPP_APP_SECRET=
# A password you invent. Type the same string into Meta when you add the
# webhook — it is echoed back once to prove the endpoint is yours.
WHATSAPP_VERIFY_TOKEN=

# --- Meta: sending ---------------------------------------------------------
# The Phone number ID from WhatsApp → API Setup. NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent System User token, not the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
# Graph API version. Defaults to v23.0; set it only to pin a different one.
WHATSAPP_GRAPH_VERSION=

# --- The review inbox ------------------------------------------------------
# Password for /inbox. Until this is set the inbox will not open at all.
INBOX_PASSWORD=

# --- Drafting --------------------------------------------------------------
# From https://console.anthropic.com. Without it the inbox still works — you
# just write every reply yourself instead of editing a draft.
ANTHROPIC_API_KEY=

# --- Storage ---------------------------------------------------------------
# Conversations need somewhere durable to live; a serverless host has no disk.
# Create a free Redis at https://upstash.com (or add Vercel KV, which is the
# same thing) and paste the REST credentials here. KV_REST_API_URL and
# KV_REST_API_TOKEN are also read, so Vercel's own variables work unchanged.
# Without these the connector keeps conversations in memory and LOSES THEM on
# every restart — fine for a local try, not for real customers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Phase two -------------------------------------------------------------
# Leave false. Set to true only when you have watched the drafts for a while
# and decided they can go out without you reading them first. Nothing in the
# code reads this yet beyond reporting it — turning it on is a deliberate,
# separate step.
WHATSAPP_AUTO_SEND=false
