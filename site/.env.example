# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, no trailing slash. Used for metadata, sitemap and Stripe
# redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.archivewholesale.co.uk

# ---------------------------------------------------------------------------
# WhatsApp click-to-chat
# ---------------------------------------------------------------------------
# Full international number, digits only, no "+", no spaces.
# UK example: 447700900123 (i.e. 07700 900123 written as 44 + number).
# Leave blank and the WhatsApp buttons stay hidden site-wide.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Stripe — payments
# ---------------------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys
# Until STRIPE_SECRET_KEY is set, checkout stays in "enquiry" mode: the cart
# still works and customers are routed to WhatsApp/email instead of card entry.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Optional. Any endpoint that accepts a JSON POST (Zapier, Make, Formspree, a
# Google Apps Script, your own inbox relay). Leave blank and the contact form
# falls back to showing the email address and WhatsApp button instead.
CONTACT_FORWARD_WEBHOOK=
